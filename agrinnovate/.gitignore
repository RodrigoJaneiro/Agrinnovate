# Android-specific files
.android/
App/build/

# Web-specific files (caso o projeto seja multi-plataforma e suporte web)
web/.dart_tool/
web/.flutter-plugins
web/.flutter-plugins-dependencies
web/build/

# Arquivos de configuração do IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

